# Server-only — never expose as VITE_* (E-10.10)
LLM_API_KEY=

# Model id from your provider (Groq Qwen 3.8 27B example below)
LLM_MODEL=qwen/qwen3.8-27b

# gemini | openai | groq | openai-compatible
# qwen* models default to openai-compatible when LLM_PROVIDER is omitted
LLM_PROVIDER=groq

# Required for groq / DashScope / other OpenAI-compatible hosts (no trailing slash)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Build-time only — used by `npm run build:library -- --unsplash`.
UNSPLASH_ACCESS_KEY=

# Client: false + LLM_API_KEY = live LLM via POST /api/llm (restart npm run dev after changes)
VITE_USE_MOCK_LLM=false
