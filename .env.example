# Server-only — never expose as VITE_* (E-10.10)

# ── Chat LLM (Groq Qwen) ─────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Embeddings (Google Gemini — separate key from Groq) ───────
# Create at https://aistudio.google.com/apikey — paste into .env only (not Vite).
EMBED_PROVIDER=google
GEMINI_API_KEY=
# Text-only (recommended): gemini-embedding-001 | Multimodal: gemini-embedding-2
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSION=768

# Groq embed instead (only if Nomic is on your Groq org):
# EMBED_PROVIDER=groq
# EMBED_MODEL=nomic-embed-text-v1_5

# ── Vision tags (build:vision-tags — research-deck photos only) ──
# Uses GEMINI_API_KEY when set; else Ollama (ollama pull moondream).
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-3.8-flash
# VISION_PROVIDER=ollama
# VISION_MODEL=moondream
# VISION_PAUSE_MS=4000

# Build-time only — used by `npm run build:library -- --unsplash`.
UNSPLASH_ACCESS_KEY=

# Client: false + LLM_API_KEY = live LLM via POST /api/llm (restart npm run dev after changes)
VITE_USE_MOCK_LLM=false

# Optional: show debug drawer in production builds (default off for shared links)
# VITE_SHOW_DEBUG=true
